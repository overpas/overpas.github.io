{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website built with Eleventy and deployed to GitHub Pages",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:md": "markdownlint-cli2",
    "lint:format": "prettier --check .",
    "lint": "run-p --aggregate-output lint:js lint:css lint:md lint:format",
    "lint:html": "html-validate \"_site/**/*.html\"",
    "check": "npm run lint && npm run build && npm run lint:html",
    "fix": "eslint . --fix; stylelint \"src/**/*.css\" --fix; prettier --write .; markdownlint-cli2 --fix",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f lint-staged.config.js ]; then npx --no-install lint-staged; fi"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-unicorn": "80.0.0",
    "eslint-plugin-yml": "3.10.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "js-yaml": "^4.1.0",
    "lint-staged": "17.6.1",
    "markdownlint-cli2": "0.24.2",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "simple-git-hooks": "2.14.0",
    "stylelint": "18.1.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.1.0"
  }
}
