---
layout: base.njk
---
{% set selected = collections.projects | featuredProjects(3) %}
{% set latest = collections.posts | head(3) %}
<section class="hero">
  <h1>{{ site.headline }}</h1>
  <p class="lede">{{ site.intro }}</p>
  <div class="link-row">
    <a class="accent-link" href="/cv/">Read my CV →</a>
    {%- if collections.projects.length %}
    <a class="accent-link" href="/projects/">See projects →</a>
    {%- endif %}
    {%- if latest.length %}
    <a class="accent-link" href="/blog/">See articles →</a>
    {%- endif %}
  </div>
</section>

{% if selected.length %}
<section class="section" aria-labelledby="sel-projects">
  <div class="section-head">
    <h2 id="sel-projects" class="label">Selected projects</h2>
    <a href="/projects/">All projects →</a>
  </div>
  <div class="rows">
    {%- for p in selected %}
    <a class="project-row" href="/projects/#{{ p.page.fileSlug }}">
      <span class="project-row__text">
        <span class="row-title">{{ p.data.title }}</span>
        <span class="row-sub">{{ p.data.tagline }}</span>
      </span>
      <span class="row-meta">{{ p.data.year }}</span>
    </a>
    {%- endfor %}
  </div>
</section>
{% endif %}

{% if latest.length %}
<section class="section" aria-labelledby="latest">
  <div class="section-head">
    <h2 id="latest" class="label">Latest writing</h2>
    <a href="/blog/">All posts →</a>
  </div>
  <div class="rows">
    {%- for post in latest %}
    <a class="post-row" href="{{ post.url }}">
      <time class="row-meta" datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time>
      <span class="row-title">{{ post.data.title }}</span>
    </a>
    {%- endfor %}
  </div>
</section>
{% endif %}
